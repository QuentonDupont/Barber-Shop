# ---- Supabase (required) ----------------------------------------------------
# Running locally? `npm run local` fills these three in for you from the Docker
# stack — you do not need to edit them.
#
# Hosted project: Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used for admin-side reads that must
# bypass RLS (e.g. sending notification emails about a booking).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Google Maps (required for business location picker) --------------------
# Enable "Places API" and "Maps JavaScript API" and restrict the key by
# HTTP referrer for the browser key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-browser-key

# ---- Email notifications (optional; booking emails are skipped without it) ---
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM="Bookly <bookings@yourdomain.com>"

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
